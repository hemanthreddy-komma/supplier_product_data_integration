# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000

# PostgreSQL Primary Database Configuration
# Default connection string for local PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/supplier_product_db

# File Storage Configuration
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Supplier Priority Configurations (1 is highest priority)
SUPPLIER_A_PRIORITY=1
SUPPLIER_B_PRIORITY=2
SUPPLIER_C_PRIORITY=3
